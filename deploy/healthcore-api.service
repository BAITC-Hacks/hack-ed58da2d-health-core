[Unit]
Description=Health Core wind forecast API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=healthcore
Group=healthcore
WorkingDirectory=/opt/healthcore/api
EnvironmentFile=/opt/healthcore/api/.env
ExecStart=/opt/healthcore/api/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/healthcore/api/data /opt/healthcore/api/models

[Install]
WantedBy=multi-user.target
