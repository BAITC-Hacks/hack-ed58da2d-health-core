DATABASE_URL=sqlite:///./healthcore.sqlite3
# Для переноса и последующего запуска укажите строку PostgreSQL здесь; она имеет приоритет над DATABASE_URL.
# SUPABASE_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
MODEL_DIR=./models
OPEN_METEO_BASE_URL=https://single-runs-api.open-meteo.com/v1/forecast
API_HOST=127.0.0.1
API_PORT=8000
DB_INIT_ON_STARTUP=true
AUTO_BOOTSTRAP=true
TZ_DIR=TZ
APP_ENV=development
# Для публичного сервера задайте случайный ключ; без него все POST доступны без авторизации.
API_WRITE_KEY=
VITE_API_URL=http://127.0.0.1:8000
# Optional Maps Demo key for the embedded Google Maps geography view.
VITE_GOOGLE_MAPS_API_KEY=YOUR_MAPS_DEMO_KEY
